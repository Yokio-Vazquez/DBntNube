# Configuración local sintética. Nunca reemplaces estos valores por secretos reales en Git.
DB_NAME=cdrl
DB_HOST=localhost
DB_PORT=5432

DB_USER_MIGRATOR=cdrl_migrator
DB_PASSWORD_MIGRATOR=replace-me-migrator

DB_USER_WRITER=cdrl_writer
DB_PASSWORD_WRITER=replace-me-writer

DB_USER_READER=cdrl_reader
DB_PASSWORD_READER=replace-me-reader
DB_PASSWORD_INVALID_TEST=replace-me-invalid-test

DB_USER_OPERATOR=cdrl_operator
DB_PASSWORD_OPERATOR=replace-me-operator

CDRL_MIGRATOR_PASSWORD=replace-me-migrator
CDRL_WRITER_PASSWORD=replace-me-writer
CDRL_READER_PASSWORD=replace-me-reader
CDRL_OPERATOR_PASSWORD=replace-me-operator

POSTGRES_DB=cdrl
POSTGRES_USER=cdrl_dev
POSTGRES_PASSWORD=replace-me-bootstrap
POSTGRES_PORT=5432

DYNAMODB_PORT=8000
DYNAMODB_ENDPOINT_URL=http://127.0.0.1:8000
DYNAMODB_TABLE=cdrl_events
DYNAMODB_TABLE_M07_TEST=cdrl_events_m07_test
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_SESSION_TOKEN=
# Version de escritura: 2 por defecto; usar 3 tras desplegar lectores compatibles. Reiniciar la API.
EVENT_WRITE_VERSION=2

# Limites de pagina: 1 <= default <= max <= 1000; reiniciar API tras cambiar.
EVENTS_PAGE_DEFAULT_LIMIT=25
EVENTS_PAGE_MAX_LIMIT=100

# Tokens de servicio M09 (autenticacion Bearer para /events). Usar tokens sinteticos aleatorios distintos.
EVENTS_READER_TOKEN=replace-me-reader-token
EVENTS_WRITER_TOKEN=replace-me-writer-token

# Benchmark M08: usa únicamente la tabla aislada con sufijo aleatorio.
DYNAMODB_TABLE_M08_TEST=cdrl_events_m08_test
M08_BENCH_EVENTS=3000
M08_BENCH_GAMES=5
M08_BENCH_HOT_GAME_SHARE=0.6
M08_BENCH_ITERATIONS=40
M08_BENCH_WARMUP=5
M08_BENCH_PAGE_SIZE=25
M08_BENCH_DEEP_PAGE=10
M08_BENCH_SEED=20261031
