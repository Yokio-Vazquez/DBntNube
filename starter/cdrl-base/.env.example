# Configuración local sintética. Nunca reemplaces estos valores por secretos reales en Git.
DB_NAME=cdrl
DB_HOST=localhost
DB_PORT=5432

DB_USER_MIGRATOR=cdrl_migrator
DB_PASSWORD_MIGRATOR=replace-me-migrator

DB_USER_WRITER=cdrl_writer
DB_PASSWORD_WRITER=replace-me-writer

DB_USER_READER=cdrl_reader
DB_PASSWORD_READER=replace-me-reader

CDRL_MIGRATOR_PASSWORD=replace-me-migrator
CDRL_WRITER_PASSWORD=replace-me-writer
CDRL_READER_PASSWORD=replace-me-reader
CDRL_OPERATOR_PASSWORD=replace-me-operator

POSTGRES_DB=cdrl
POSTGRES_USER=cdrl_dev
POSTGRES_PASSWORD=replace-me-bootstrap
POSTGRES_PORT=5432

DYNAMODB_PORT=8000
AWS_REGION=us-east-1